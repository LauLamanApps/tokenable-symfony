{
    "name": "laulamanapps/tokenable-symfony",
    "description": "Reversible, type-prefixed, non-enumerable tokens for Doctrine entities in Symfony. Attribute-driven, with automatic route/URL encoding, controller argument resolution and a profiler panel.",
    "type": "symfony-bundle",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "doctrine",
        "token",
        "obfuscation",
        "optimus",
        "identifier",
        "url"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Laurens Laman",
            "email": "laurens.laman@llaman.nl"
        }
    ],
    "require": {
        "php": ">=8.4",
        "doctrine/orm": "^3.0",
        "symfony/config": "^7.1 || ^8.0",
        "symfony/console": "^7.3 || ^8.0",
        "symfony/dependency-injection": "^7.1 || ^8.0",
        "symfony/http-foundation": "^7.1 || ^8.0",
        "symfony/http-kernel": "^7.1 || ^8.0",
        "symfony/routing": "^7.1 || ^8.0"
    },
    "require-dev": {
        "phpseclib/phpseclib": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5",
        "symfony/framework-bundle": "^7.1 || ^8.0",
        "symfony/web-profiler-bundle": "^7.1 || ^8.0",
        "twig/twig": "^3.0",
        "jenssegers/optimus": "^0.2.3 || ^1.1"
    },
    "suggest": {
        "jenssegers/optimus": "Only for bin/console app:tokenable:generate, which mints prime/inverse triplets. Encoding and decoding need no extra package.",
        "phpseclib/phpseclib": "Same: only needed by app:tokenable:generate."
    },
    "autoload": {
        "psr-4": {
            "LauLamanApps\\Tokenable\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LauLamanApps\\Tokenable\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
